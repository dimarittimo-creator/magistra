# Copia questo file in .env.local e compila i valori.
# In sviluppo locale .env.local si genera da solo con:  npm run db:env
# (legge le chiavi dal Supabase locale avviato con npm run db:start)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server, mai nel browser
SUPABASE_SERVICE_ROLE_KEY=

# Indirizzo pubblico del sito (link nelle email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo (email). Senza chiave, in sviluppo le email finiscono nella casella di prova
# locale (Mailpit, http://127.0.0.1:54324); in produzione la chiave è obbligatoria.
BREVO_API_KEY=
EMAIL_MITTENTE=
# Facoltativo: indirizzo di Mailpit se diverso da quello predefinito
# MAILPIT_URL=http://127.0.0.1:54324

# Chiave dei job pianificati (Vercel la invia come "Authorization: Bearer …").
# In locale si può lasciare vuota.
CRON_SECRET=

# Anthropic (assistente/chatbot, Fase 6). Servizio a pagamento: chiave da console.anthropic.com.
# Senza chiave: in locale l'assistente usa la "modalità di prova" (risposte simulate, gratis);
# online le domande vanno direttamente a un operatore.
ANTHROPIC_API_KEY=
# Facoltativo: "prova" forza le risposte simulate (solo in locale), "spento" disattiva l'assistente automatico.
# ASSISTENTE_MODALITA=
# Facoltativo, NON attivo: ricerca per significato nella base di conoscenza (Voyage AI, a pagamento).
# Senza chiave la ricerca è per parole, sempre disponibile.
# VOYAGE_API_KEY=
